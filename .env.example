# PostgreSQL: Supabase, Neon, Vercel Postgres and self-hosted Postgres all use this one URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# One-admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Optional alternative to ADMIN_PASSWORD (bcrypt hash)
# ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Uploaded images and PDFs are stored in PostgreSQL by default. No separate storage token is required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
